parameters:
	ignoreErrors:
		-
			message: '#^Call to function assert\(\) with true will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Http/Controllers/RestaurantController.php

		-
			message: '#^Strict comparison using \!\=\= between array\{lat\: float, lng\: float\} and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: app/Http/Controllers/RestaurantController.php

		-
			message: '#^Offset 0 might not exist on array\{Illuminate\\Http\\Client\\Request, Illuminate\\Http\\Client\\Response\|null\}\|null\.$#'
			identifier: offsetAccess.notFound
			count: 5
			path: tests/Feature/OverpassServiceTest.php

		-
			message: '#^Offset ''name'' might not exist on array\<mixed\>\|null\.$#'
			identifier: offsetAccess.notFound
			count: 2
			path: tests/Feature/RestaurantControllerTest.php

		-
			message: '#^Offset ''normalized'' might not exist on array\{label\: string, weight\: float, normalized\: float, contribution\: float, detail\: string\}\|null\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: tests/Unit/PopularityScoreServiceTest.php

		-
			message: '#^Cannot access property \$id on App\\Models\\Restaurant\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: tests/Unit/RestaurantEnrichmentProcessFreeVenueTest.php

		-
			message: '#^Offset ''score_breakdown'' might not exist on array\|null\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: tests/Unit/RestaurantResourceAggregatesTest.php
