parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type DOMNodeList\<DOMNameSpaceNode\|DOMNode\>\|false supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: app/Console/Commands/BackfillRestaurantWebsites.php

		-
			message: '#^Method App\\Console\\Commands\\DeduplicateRestaurants\:\:findDuplicatePairs\(\) should return array\<int, array\{keep_id\: int, dupe_id\: int, name\: string\}\> but returns array\<int, array\>\.$#'
			identifier: return.type
			count: 1
			path: app/Console/Commands/DeduplicateRestaurants.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(int\|string\)\: mixed\)\|null, ''strtolower'' given\.$#'
			identifier: argument.type
			count: 1
			path: app/Console/Commands/EnrichRestaurants.php

		-
			message: '#^Property App\\Models\\BlogPost\:\:\$author_id \(int\<0, max\>\) does not accept int\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Http/Controllers/Admin/BlogPostController.php

		-
			message: '#^Parameter \#1 \$sql of method Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\Restaurant\>\:\:orderByRaw\(\) expects literal\-string, non\-falsy\-string given\.$#'
			identifier: argument.type
