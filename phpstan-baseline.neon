			identifier: argument.type
			count: 1
			path: app/Services/HtmlSanitizer.php

		-
			message: '#^Offset ''bizdata''\|''overpass''\|''serpapi''\|''socrata'' might not exist on array\{\}\|array\{bizdata\?\: string, serpapi\?\: string, socrata\?\: string, overpass\?\: string\}\.$#'
