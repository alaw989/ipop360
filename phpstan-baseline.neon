parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Console\\Commands\\BackfillRestaurantLocation\:\:extractCityState\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Console/Commands/BackfillRestaurantLocation.php


		-
			message: '#^Method App\\Http\\Controllers\\Admin\\BlogPostController\:\:validated\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Controllers/Admin/BlogPostController.php

		-
			message: '#^Method App\\Services\\RestaurantEnrichmentService\:\:processFreeVenue\(\) has parameter \$venue with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/RestaurantEnrichmentService.php

		-
			message: '#^Method App\\Services\\WikidataService\:\:parseBindings\(\) has parameter \$bindings with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/WikidataService.php
