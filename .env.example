APP_NAME=iPop360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# External API keys (optional - app works without any keys)
SERPAPI_API_KEY=
SOCRATA_APP_TOKEN=
SOCRATA_NYC_DATASET_ID=py6s-7cay
SOCRATA_SF_DATASET_ID=vw6y-z8j6
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_KEY=
AI_FALLBACK_URL=https://api.cerebras.ai/v1
AI_FALLBACK_MODEL=gpt-oss-120b
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Ranking weights (optional). Defaults live in config/restaurant-finder.php.
# Free signals must stay meaningful (they renormalize over their active set).
RANK_WEIGHT_QUALITY=0.35
RANK_WEIGHT_PROXIMITY=0.15
RANK_WEIGHT_DATA_COMPLETENESS=0.05
RANK_WEIGHT_HAS_AWARD=0.05
# Cuisine-match boost applied only on cuisine-scoped live searches
RANK_WEIGHT_CUISINE_MATCH=0.50
# Social + engagement signals (activate only when a count exists)
RANK_WEIGHT_SOCIAL_LINKS_COUNT=0.20
RANK_WEIGHT_WEBSITE_CLICKS=0.20
RANK_WEIGHT_PAGEVIEWS=0.10
RANK_WEIGHT_SOCIAL_LINK_CLICKS=0.05
RANK_WEIGHT_MENU_CLICKS=0.05
# Paid bonus signals (no-op without keys, weight active only when a value exists)
RANK_WEIGHT_GOOGLE_RATING=0
RANK_WEIGHT_GOOGLE_REVIEW_COUNT=0
RANK_WEIGHT_POPULAR_TIMES=0
# Bayesian quality prior: reviews needed before rating is treated as credible
RANK_QUALITY_PRIOR=50
# Fallback credible-mean rating when no venue meets the prior threshold
RANK_QUALITY_MEAN_FALLBACK=4.0
# Proximity scale (km): at 1× scale (default 2km), a venue at 2km scores 0.5
RANK_PROXIMITY_SCALE_KM=2.0
# Log review-count normalization (denominator = max(collectionMax, floor), default when empty)
RANK_LOG_REVIEW_FLOOR=500
RANK_LOG_REVIEW_DEFAULT=5000
# Name-similarity threshold for matching Wikidata award records
RANK_AWARD_NAME_SIMILARITY=0.7

# --- Live search timeouts and caps (seconds, km, count) ---
LIVE_SEARCH_HTTP_TIMEOUT=8.0
LIVE_SEARCH_OVERPASS_TIMEOUT=10.0
LIVE_SEARCH_SOCRATA_TIMEOUT=8.0
LIVE_SEARCH_MAX_DISTANCE_KM=50.0
LIVE_SEARCH_MAX_RESULTS=30
LIVE_SEARCH_MIN_SCORE=0.0
# Fallback geolocation for distance filtering when IP/IP-api are unavailable
# (e.g. local dev on 127.0.0.1). Set to your seeded test region. Omit or leave
# empty to keep the default "no coords → distance filter silently skipped" behaviour.
#DISTANCE_FALLBACK_LAT=30.6199
#DISTANCE_FALLBACK_LNG=-88.1967

# --- Dedup thresholds (km, percentage) ---
DEDUP_MATCH_RADIUS_KM=0.2
DEDUP_NAME_SIMILARITY_THRESHOLD=85.0

# --- DB enrichment caps (SerpApi quota protection) ---
# Max real SerpApi calls per enrich run (cache hits don't count).
ENRICH_PER_RUN_CAP=15
# Max real SerpApi calls per 30-day rolling window (default 150 of 250 quota).
ENRICH_MONTHLY_BUDGET=150

# --- SerpApi cache and quota ---
SERPAPI_CACHE_TTL_HOURS=720
# Monthly quota (current plan = 250).
SERPAPI_FREE_QUOTA=250
# Master kill-switch for the read-path quota guard.
SERPAPI_READ_PATH_GUARD=true
# Circuit breaker fraction: when calls reach this % of free_quota, live path stops.
SERPAPI_CIRCUIT_BREAKER_FRACTION=0.8
# Per-IP cap on distinct cache-miss live fetches per hour.
SERPAPI_LIVE_MISSES_PER_HOUR=30

# --- External API cache TTLs (hours) ---
# Other external sources — free/unlimited, shorter TTLs are fine
OVERPASS_CACHE_TTL_HOURS=24
BIZDATA_CACHE_TTL_HOURS=24
SOCRATA_CACHE_TTL_HOURS=24

# --- Preview snapshot TTL ---
PREVIEW_SNAPSHOT_DAYS=7

# --- Garbage name filters ---
GARBAGE_GENERIC_WORDS=diner restaurant cafe pizza bar grill bistro pub tavern eatery food kitchen cantina

# --- Cuisine filter source controls ---
# Sources that do NOT filter by cuisine (returns all nearby venues)
CUISINE_UNFILTERED_SOURCES=bizdata
# When true, scrutinize trusted sources (serpapi/overpass/foursquare) for off-cuisine rows
SCRUTINIZE_TRUSTED_SOURCES=true
# When true, drop rows whose Google place_types indicate non-restaurants
SCRUTINIZE_PLACE_TYPES=true

# --- Uptime alerting webhook (Slack or generic) ---
# Used by uptime:canary to notify on 3+ consecutive degraded checks.
ALERTING_WEBHOOK_URL=
# Number of consecutive degraded checks before firing the webhook.
ALERTING_CONSECUTIVE_THRESHOLD=3

# Laravel Pulse (observability)
PULSE_ENABLED=true
PULSE_PATH=pulse
# spec-076: comma-separated allow-list of emails that may view /pulse in prod.
# Empty = no one (dashboard private). Needed because registration is open.
PULSE_ADMIN_EMAILS=

# Operator notifications (e.g. "new user registered"). Comma-separated recipient
# list, kept separate from the user's own verification email. Empty = off.
ADMIN_NOTIFY_EMAILS=
